# ---------------------------------------------------------------------------
# Smith AI SaaS MVP — environment template (I2 / AC13 / Working Rule 5)
#
# Copy to `.env` and fill in real values. Every variable required to start,
# test, seed, or operate the MVP is listed here with safe, non-secret
# placeholders. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Strapi / identity-cms (apps/identity-cms) -----------------------------
# Server
HOST=0.0.0.0
PORT=1337

# Secrets (Strapi requires these; generate real values, do not reuse these
# placeholders in production)
APP_KEYS=tobemodified1,tobemodified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (read by apps/identity-cms/config/database.ts — fixes G3/AC13)
DATABASE_CLIENT=sqlite
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
DATABASE_FILENAME=.tmp/data.db

# --- Convex (conversations + session history; Q1) --------------------------
# Hosted deployment URL exposed to the dashboard and apps/api.
CONVEX_URL=https://your-project.convex.cloud
# Deploy key used only to deploy functions (never commit a real key).
CONVEX_DEPLOY_KEY=

# --- apps/api (NestJS; external surface, Q2) -------------------------------
# Port the API listens on.
API_PORT=3000
# Base URL of the Strapi instance apps/api talks to.
STRAPI_URL=http://localhost:1337
# The Strapi JWT secret used to validate session access tokens.
API_JWT_SECRET=tobemodified

# --- apps/dashboard (React + Vite; direct Convex chat, Q2) ------------------
# Public env vars exposed to the browser (Vite VITE_*).
VITE_CONVEX_URL=https://your-project.convex.cloud
VITE_STRAPI_URL=http://localhost:1337
# Base URL of apps/api (the external surface used by the admin audit + role).
VITE_API_URL=http://localhost:3000
# Landing app URL used to redirect unauthenticated users back to login (S4).
VITE_LANDING_URL=http://localhost:4321

# --- apps/landing (Astro; login/register, Q3) -------------------------------
# Public env vars exposed to the browser (Astro PUBLIC_*).
PUBLIC_STRAPI_URL=http://localhost:1337
PUBLIC_DASHBOARD_URL=http://localhost:4200

# --- Seed (I1) --------------------------------------------------------------
# Credentials the seed script writes to Strapi (safe placeholders; override).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe_Admin1
SEED_USER_EMAIL=user@example.com
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=ChangeMe_User1
# Strapi admin API token used by the seed to promote the admin user to the
# `admin` end-user role (create a users-permissions API token in the Strapi
# admin panel; if omitted the seed still creates regular users but cannot
# promote the admin role).
STRAPI_ADMIN_API_TOKEN=
