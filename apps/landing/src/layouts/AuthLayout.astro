---
interface Props {
  title: string;
}

const { title } = Astro.props;
const strapiUrl =
  import.meta.env.PUBLIC_STRAPI_URL ?? 'http://localhost:1337';
const dashboardUrl =
  import.meta.env.PUBLIC_DASHBOARD_URL ?? 'http://localhost:4200';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body data-strapi-url={strapiUrl} data-dashboard-url={dashboardUrl}>
    <main class="landing">
      <section class="hero">
        <h1>Smith AI SaaS</h1>
        <p class="tagline">
          Your AI-powered workspace with per-user conversation history,
          role-based audit, and a clean, focused chat experience.
        </p>
      </section>
      <slot />
    </main>

    <style is:global>
      .landing {
        max-width: 42rem;
        margin: 3rem auto;
        padding: 0 1rem;
        font-family: system-ui, -apple-system, sans-serif;
      }
      .hero h1 {
        margin-bottom: 0.25rem;
      }
      .tagline {
        color: #444;
        line-height: 1.5;
      }
      .panel {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 1.5rem;
      }
      .field {
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
      }
      .field label {
        margin-bottom: 0.25rem;
      }
      .field input {
        padding: 0.5rem;
      }
      button {
        padding: 0.5rem 1.25rem;
        cursor: pointer;
      }
      .error {
        color: #b00020;
        margin-top: 0.75rem;
      }
      .auth-switch {
        margin-top: 1rem;
      }
    </style>
  </body>
</html>
