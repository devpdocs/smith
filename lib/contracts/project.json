{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/contracts/src",
  "projectType": "library",
  "tags": ["scope:mvp-shared", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/lib/contracts",
        "main": "lib/contracts/src/index.ts",
        "tsConfig": "lib/contracts/tsconfig.lib.json",
        "assets": ["lib/contracts/*.md"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "lib/contracts",
        "command": "tsc --noEmit -p tsconfig.lib.json"
      }
    }
  }
}
